# Doxygen configuration for the PICO9918 firmware and the pico9918-core library.
#
#   doxygen Doxyfile
#
# Output lands in build/doc/html, which is already ignored by build*/**.
# Only the settings that differ from the defaults are listed, so this stays
# readable and survives `doxygen -u` without turning into 2500 lines.

PROJECT_NAME           = PICO9918
PROJECT_NUMBER         = @PICO9918_VERSION@
PROJECT_BRIEF          = "TMS9918A / F18A video display processor on an RP2040 or RP2350"
OUTPUT_DIRECTORY       = doc
HTML_OUTPUT            = code

# ---------------------------------------------------------------------------
# What to read
# ---------------------------------------------------------------------------
INPUT                  = docs/mainpage.md \
                         BUILDING.md \
                         DEBUGGING.md \
                         src \
                         test \
                         core/src \
                         core/test \
                         core/examples
FILE_PATTERNS          = *.c *.h *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = docs/mainpage.md

# board headers come from the Pico SDK's template and are not ours to document
EXCLUDE                = src/boards

# ---------------------------------------------------------------------------
# What to document
# ---------------------------------------------------------------------------
# Everything, statics included: the renderer's emitters are static and are the
# part a reader most needs explained.
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PACKAGE        = YES
EXTRACT_LOCAL_CLASSES  = YES
INTERNAL_DOCS          = YES

# EXTRACT_ALL is off so that these warnings mean something: an undocumented
# function is a gap to fill, not noise to silence.
#
# WARN_NO_PARAMDOC stays off. The house style is a one-line \brief, and a full
# \param list per function would be the comment bloat this codebase avoids;
# \param and \return are written where the answer is not in the signature.
#
# Every function, type and file is documented; file-scope macros and variables
# are covered by a group comment over the block instead, so doxygen still warns
# for each one. Filter those out to read the list:
#   doxygen Doxyfile 2>&1 | grep -v "(macro definition)\|(variable)"
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

# ---------------------------------------------------------------------------
# C, not C++
# ---------------------------------------------------------------------------
OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = YES
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO
TAB_SIZE               = 2

# ---------------------------------------------------------------------------
# Preprocessing
# ---------------------------------------------------------------------------
# Without these the SDK's placement wrappers and the library's instance-argument
# macros swallow the signatures and half the file comes out undocumented.
#
# The RP2350 is predefined rather than the RP2040 so that the docs describe the
# larger feature set - the 8bpp 80-column tier only exists on that build.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SKIP_FUNCTION_MACROS   = NO
INCLUDE_PATH           = src core/src

# these stand in for an argument list, so the signature is wrong without them
EXPAND_AS_DEFINED      = TILE_ROW_PARAMS \
                         TEXT_ROW_PARAMS

PREDEFINED             = __attribute__(x)= \
                         bi_decl(x)= \
                         TEXT_ROW_CLONE(a,b,c,d)= \
                         TEXT80_ROW_CLONE(a,b,c)= \
                         LOCKED_ROW_CLONE(a,b,c)= \
                         TILE_ROW_CLONE(a,b,c,d,e)= \
                         __aligned(x)= \
                         __time_critical_func(x)=x \
                         __not_in_flash_func(x)=x \
                         __in_flash_func(x)=x \
                         __uninitialized_ram(x)=x \
                         __cold_in_flash(x)= \
                         PICO9918_IN_FLASH_FUNC(x)=x \
                         EMITTER_NOINLINE= \
                         PICO9918_DLLEXPORT= \
                         PICO9918_DLLEXPORT_CONST= \
                         PICO9918_SINGLE_INSTANCE=1 \
                         PICO9918_INST_ARG= \
                         PICO9918_INST_ONLY_ARG=void \
                         PICO9918_INST= \
                         PICO9918_INST_ONLY= \
                         PICO_BUILD=1 \
                         PICO_RP2350=1 \
                         PICO9918_TEXT80_8BPP=1

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
HTML_DYNAMIC_SECTIONS  = YES
SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
ALPHABETICAL_INDEX     = YES
SORT_MEMBER_DOCS       = NO
